#!/bin/sh
# Boot slot marker in mmcblk0p1, read by the stock SPL on every power-up:
#   "ota:kernel"  -> slot 1 (kernel p5, rootfs p7)
#   "ota:kernel2" -> slot 2 (kernel p6, rootfs p8)
# The SPL has no boot counter and no fallback, so Datel OS boots as a trial:
#   trial    first thing at boot: point the marker at the other slot, so a
#            hang or a power cycle from here on brings the other system back.
#            Not when the other slot holds no system (see below): then the
#            marker stays where it is.
#   confirm  after /usr/data is up: point it back at this slot, but only if
#            /usr/data/k1os/boot-keep names this slot
#   keep     write this slot's name into boot-keep and stay on it from now on
#   release  remove boot-keep; the next boot goes to the other slot
#   status   show the running slot, the next slot and boot-keep
#
# boot-keep holds the marker text of the slot that was kept. /usr/data is
# shared by both slots, so a file that only had to exist was also true for
# the system written into the other slot afterwards: that one confirmed
# itself on its first boot, before anyone had seen it run. A boot-keep
# without a name (written by Datel OS up to 0.8.1) keeps no slot of this
# system; the older system that wrote it still reads it as its own.
#
# A slot that is being written holds no system: tools/flash-slot2.sh zeroes
# the first 4 KiB of its kernel and of its rootfs before the write and puts
# them in last, after the read-back. A slot whose kernel or rootfs starts
# with a zero block is never made the next boot.
#
# With the open bootloader (recipes-bsp/u-boot-k1) there is a second net that
# does not depend on this system starting: a boot counter in U-Boot's
# environment (/etc/fw_env.config, 32 KiB at eMMC byte 0x6A400). While
# k1_trial=1 the bootloader counts every boot and, past k1_bootlimit, points
# the marker at the other slot itself. That covers what the trial above cannot:
# a kernel that never reaches the first service. The stock bootloader leaves
# that area zero, fw_printenv then reports a bad CRC, and everything here
# works by the marker alone, as before.
#   arm [s]  count the boots of the slot the marker names (k1_trial=1). For a
#            slot that holds Datel OS only: stock never confirms, so a counter
#            armed for it would send the printer back after k1_bootlimit boots.
#            With a number of seconds the bootloader also starts the watchdog
#            for every counted boot (k1_wdt), so that a kernel which hangs
#            without a panic is reset and counted too. Only for a slot whose
#            kernel takes a running watchdog over: Datel OS's kernels before
#            k1-linux's "leave a watchdog the boot loader started as it is"
#            are reset by it within a second, three times, and the printer
#            falls back. Without a number, and for an older bootloader that
#            knows no k1_wdt, the counter works as before.
#   confirm  also ends the count (k1_trial=0, k1_bootcount=0); a system that
#            got this far has started, whether it is kept or not
#   status   also shows the counter
#
# The paths can be set from outside for k1os-slot-test.sh.

M=${K1OS_SLOT_MARKER:-/dev/mmcblk0p1}
KEEP=${K1OS_SLOT_KEEP:-/usr/data/k1os/boot-keep}
CMDLINE=${K1OS_SLOT_CMDLINE:-/proc/cmdline}
PART=${K1OS_SLOT_PART:-/dev/mmcblk0p}
RUN=${K1OS_SLOT_RUN:-/run}
FW_PRINTENV=${K1OS_SLOT_FW_PRINTENV:-fw_printenv}
FW_SETENV=${K1OS_SLOT_FW_SETENV:-fw_setenv}

running() {
    case " $(cat "$CMDLINE") " in
        *" root=/dev/mmcblk0p8 "*) echo ota:kernel2 ;;
        *" root=/dev/mmcblk0p7 "*) echo ota:kernel ;;
        *) echo unknown ;;
    esac
}

other() {
    case "$(running)" in
        ota:kernel2) echo ota:kernel ;;
        ota:kernel) echo ota:kernel2 ;;
        *) echo unknown ;;
    esac
}

current() {
    dd if="$M" bs=512 count=1 2>/dev/null | tr -d '\000' | head -n 1
}

# The slot that boot-keep names; nothing for a file without a name
kept() {
    [ -e "$KEEP" ] || return 0
    case "$(head -n 1 "$KEEP" 2>/dev/null)" in
        ota:kernel) echo ota:kernel ;;
        ota:kernel2) echo ota:kernel2 ;;
    esac
}

# Does the first 4 KiB of a partition hold anything but zeros?
has_data() {
    [ "$(dd if="$1" bs=4096 count=1 2>/dev/null | tr -d '\000' | wc -c)" -gt 0 ]
}

# Does the slot of this marker text hold a system? Only a slot that
# flash-slot2.sh marked as being written says no; a partition that cannot
# be read says yes, as before there was this check.
holds_system() {
    case "$1" in
        ota:kernel) k=5; r=7 ;;
        ota:kernel2) k=6; r=8 ;;
        *) return 1 ;;
    esac
    for p in $k $r; do
        [ -r "$PART$p" ] || continue
        has_data "$PART$p" || return 1
    done
    return 0
}

# Is the open bootloader there, with an environment it has saved?
uboot_env() {
    command -v "$FW_PRINTENV" >/dev/null 2>&1 && "$FW_PRINTENV" k1_env_saved >/dev/null 2>&1
}

uboot_var() {
    "$FW_PRINTENV" -n "$1" 2>/dev/null || echo "$2"
}

# End the count. Writes only when something is set, to spare the eMMC.
uboot_confirm() {
    uboot_env || return 0
    if [ "$(uboot_var k1_trial 0)" != 0 ] || [ "$(uboot_var k1_bootcount 0)" != 0 ]; then
        "$FW_SETENV" k1_trial 0 && "$FW_SETENV" k1_bootcount 0 && echo "k1os-slot: boot counter cleared"
    fi
}

# The count to zero first: a power cut between the two writes leaves no trial
# rather than a trial that starts from an old count.
uboot_arm() {
    if ! uboot_env; then
        echo "k1os-slot: no open bootloader environment, nothing to arm" >&2
        return 1
    fi
    case "${1:-0}" in
        ''|*[!0-9]*) echo "k1os-slot: '$1' is no number of seconds, nothing armed" >&2; return 1 ;;
    esac
    # The watchdog's time first: a power cut before the trial is set leaves
    # no trial, and one after it a trial with the time that was asked for.
    "$FW_SETENV" k1_wdt "${1:-0}" && "$FW_SETENV" k1_bootcount 0 && "$FW_SETENV" k1_trial 1 || return 1
    if [ "${1:-0}" -gt 0 ]; then
        echo "k1os-slot: counting the next $(uboot_var k1_bootlimit 3) boots of $(current), each with $1 s on the watchdog"
    else
        echo "k1os-slot: counting the next $(uboot_var k1_bootlimit 3) boots of $(current)"
    fi
}

uboot_status() {
    if uboot_env; then
        echo "u-boot:  open, trial=$(uboot_var k1_trial 0) bootcount=$(uboot_var k1_bootcount 0)/$(uboot_var k1_bootlimit 3)"
    else
        echo "u-boot:  stock (no environment)"
    fi
}

write() {
    case "$1" in
        ota:kernel|ota:kernel2) ;;
        *) echo "k1os-slot: '$1' is no slot, marker untouched" >&2; return 1 ;;
    esac
    [ "$(current)" = "$1" ] && return 0
    # Build the whole 512-byte block first (text, two newlines, zeros, as
    # stock writes it) and write it in one go, so p1 is never left half-written.
    n=$((${#1} + 2))
    b=$RUN/k1os-slot.$$
    { printf '%s\n\n' "$1"; dd if=/dev/zero bs=$((512 - n)) count=1 2>/dev/null; } > "$b"
    dd if="$b" of="$M" bs=512 count=1 2>/dev/null
    rm -f "$b"
    sync
    if [ "$(current)" != "$1" ]; then
        echo "k1os-slot: marker write failed, p1 reads '$(current)'" >&2
        return 1
    fi
    echo "k1os-slot: next boot is $1"
}

case "$1" in
    trial)
        o=$(other)
        [ "$o" = unknown ] && { echo "k1os-slot: unknown root in $CMDLINE, marker untouched" >&2; exit 0; }
        if ! holds_system "$o"; then
            echo "k1os-slot: the other slot ($o) holds no system, marker stays $(current)" >&2
            exit 0
        fi
        write "$o" ;;
    confirm)
        r=$(running)
        if [ "$r" != unknown ] && [ "$(kept)" = "$r" ]; then
            write "$r"
        else
            echo "k1os-slot: trial boot, next boot is $(current)"
        fi
        uboot_confirm ;;
    keep)
        r=$(running)
        [ "$r" = unknown ] && { echo "k1os-slot: unknown root in $CMDLINE, nothing kept" >&2; exit 1; }
        # the name first, whole, then the marker
        printf '%s\n' "$r" > "$KEEP.new" && mv "$KEEP.new" "$KEEP" || exit 1
        sync
        write "$r" && uboot_confirm ;;
    release)
        o=$(other)
        [ "$o" = unknown ] && { echo "k1os-slot: unknown root in $CMDLINE, nothing released" >&2; exit 1; }
        if ! holds_system "$o"; then
            echo "k1os-slot: the other slot ($o) holds no system, nothing released" >&2
            exit 1
        fi
        rm -f "$KEEP"; write "$o" ;;
    arm)
        uboot_arm "${2:-0}" ;;
    status)
        r=$(running)
        k=$(kept)
        echo "running: $r"
        echo "next:    $(current)"
        if [ "$r" != unknown ] && [ "$k" = "$r" ]; then
            echo "keep:    yes"
        elif [ -n "$k" ]; then
            echo "keep:    no (trial; boot-keep names $k)"
        elif [ -e "$KEEP" ]; then
            echo "keep:    no (trial; boot-keep names no slot)"
        else
            echo "keep:    no (trial)"
        fi
        holds_system "$(other)" || [ "$(other)" = unknown ] || echo "other:   no system (being written, or a write broke off)"
        uboot_status ;;
    *)
        echo "usage: k1os-slot trial|confirm|keep|release|arm [seconds]|status" >&2; exit 1 ;;
esac
