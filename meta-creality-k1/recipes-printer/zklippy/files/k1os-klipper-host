#!/bin/sh
# k1os-klipper-host [zklippy|kalico]: show or change the Klipper host that
# klipper.service runs. The choice lives in /usr/data/k1os/klipper-host and
# outlasts reboots and updates; without the file it is zklippy.
#
# A change restarts klipper.service, so it is refused while a print runs or
# is paused, and also while Klipper runs but cannot say that it is idle. The
# heaters are turned off first: a heater left on is shut off by its MCU once
# the host stops updating it, and that MCU then stays in shutdown until a
# FIRMWARE_RESTART.
f=/usr/data/k1os/klipper-host
now=$(cat $f 2>/dev/null)
[ -n "$now" ] || now=zklippy
case "$1" in
"")
    echo "$now"; exit 0 ;;
zklippy|kalico)
    ;;
*)
    echo "usage: k1os-klipper-host [zklippy|kalico]" >&2; exit 2 ;;
esac
if systemctl -q is-active klipper; then
    q="http://127.0.0.1:7125/printer/objects/query?print_stats=state"
    state=$(wget -T 5 -qO- "$q" 2>/dev/null | sed -n 's/.*"state": *"\([a-z]*\)".*/\1/p')
    case "$state" in
    standby|complete|cancelled|error) ;;
    *) echo "k1os-klipper-host: the print state is '$state', nothing changed" >&2; exit 1 ;;
    esac
    wget -T 5 -qO- --post-data= "http://127.0.0.1:7125/printer/gcode/script?script=TURN_OFF_HEATERS" >/dev/null 2>&1
fi
echo "$1" > $f.new && mv $f.new $f && sync
systemctl restart klipper
echo "klipper.service runs $1"
