#!/bin/sh
# klipper.service runs this: zklippy, the Zig port of Kalico's host, unless
# /usr/data/k1os/klipper-host says kalico. k1os-klipper-host changes it.
cfg=/usr/data/k1os/printer_data/config/printer.cfg
log=/usr/data/k1os/printer_data/logs/klippy.log
case "$(cat /usr/data/k1os/klipper-host 2>/dev/null)" in
kalico)
    exec /usr/bin/python3 /usr/share/klipper/klippy/klippy.py "$cfg" -l "$log" -a /tmp/klippy_uds ;;
*)
    exec /usr/share/klipper/zklippy "$cfg" -l "$log" -a /tmp/klippy_uds ;;
esac
